# Blush Beauty Salon — copy to .env for local development. Never commit .env.
PORT=8080
ENV=development
# PostgreSQL (production). Leave empty to use local SQLite (blush.db) for development.
DATABASE_URL=
# Example Postgres URL:
# DATABASE_URL=postgres://user:password@localhost:5432/blush_salon?sslmode=disable
# SQLite fallback: DATABASE_URL=sqlite:blush.db
JWT_SECRET=change-me-to-a-long-random-secret-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://hannashiferaw.github.io
SEED_DEMO=true
SALON_NAME=Blush Beauty Salon
ADMIN_EMAIL=admin@blushsalon.com
ADMIN_PASSWORD=Admin123!
